{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Spider Solitaire",
  "version": "0.1.0",
  "identifier": "dev.time2code.spidersolitaire",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Spider Solitaire",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Game",
    "shortDescription": "A modern Spider Solitaire for macOS.",
    "longDescription": "Spider Solitaire with 1-suit, 2-suit, and 4-suit modes, undo, hints, persistent stats, and polished visuals.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
